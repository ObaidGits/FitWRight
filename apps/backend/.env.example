# ===========================================
# LLM Provider Configuration
# ===========================================
# Supported providers:
#   openai, openai_compatible, anthropic, openrouter, gemini, deepseek, ollama
# openai_compatible = llama.cpp, vLLM, LM Studio, and any self-hosted server
# that exposes the OpenAI Chat Completions API. API key is optional for this
# provider (backend passes a sentinel when blank).
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-nano-2025-08-07
# Optional for startup. Configure a provider key in Settings after launch, or
# set it here for cloud-backed AI features. Never commit a real key.
LLM_API_KEY=

# For Ollama (local models)
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma3:4b
# LLM_API_BASE=http://localhost:11434
#
# IMPORTANT: For Docker deployments with Ollama on host machine:
# Use host.docker.internal instead of localhost:
# LLM_API_BASE=http://host.docker.internal:11434
# (Works on macOS/Windows. On Linux, use your host IP or --network=host)

# For llama.cpp / vLLM / LM Studio (OpenAI-compatible local servers)
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=llama-3.1-8b  # or whatever model your server exposes
# LLM_API_BASE=http://localhost:8080/v1  # llama.cpp default; adjust per server
# LLM_API_KEY=  # leave blank if your server doesn't require auth

# For OpenRouter
# LLM_PROVIDER=openrouter
# LLM_MODEL=deepseek/deepseek-chat
# LLM_API_KEY=sk-or-v1-your-key

# For Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_API_KEY=sk-ant-your-key

# For Google Gemini
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini/gemini-3-flash-preview
# LLM_API_KEY=your-gemini-key

# For DeepSeek
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=your-deepseek-key

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
PORT=8000
# Set RELOAD=true for `uv run app` to auto-reload on file changes (dev only)
RELOAD=false
# Return 503 for product routes while keeping operator/admin and health access.
MAINTENANCE_MODE=false
# Reasoning effort for models that support it: minimal | low | medium | high
# Leave unset (or blank) for maximum provider compatibility. LiteLLM will
# drop this parameter for providers that don't support it.
# REASONING_EFFORT=
LOG_LEVEL=INFO
LOG_LLM=WARNING

# Frontend URL - Used for PDF generation
FRONTEND_BASE_URL=http://localhost:3000

# ===========================================
# Resilience toggles (P4 / ADR-14)
# ===========================================
# STREAMING_AI_ENABLED: stream AI generation (resume tailoring, etc.) over SSE
# so the UI shows honest, real per-stage progress (Analyzing the role ->
# Planning -> Rewriting -> Refining -> Scoring) instead of falling back to the
# non-streaming endpoint (which shows no stage progress). Recommended ON.
# NOTE: does NOT change token usage - streaming delivers the same output
# incrementally. The configured provider must support streaming; if not, the
# client transparently falls back to the non-stream path.
STREAMING_AI_ENABLED=true
# Offline support (service worker + offline outbox). Off by default.
OFFLINE_SUPPORT_ENABLED=false
# Advanced server autosave (durable drafts + conflict resolution). On by default.
ADVANCED_AUTOSAVE_ENABLED=true
# Streaming guardrails: per-user concurrent streams, max stream lifetime (s),
# and the heartbeat TTL (s) after which an abandoned stream's slot is reclaimed.
STREAM_MAX_CONCURRENT_PER_USER=3
STREAM_MAX_LIFETIME_SECONDS=300
STREAM_HEARTBEAT_SECONDS=15

# Hard timeout (seconds) for a single resume tailoring/improve request.
# Default 240. Raise it for slow local LLMs (Ollama, llama.cpp, ...); bounded
# to [30, 1800]. IMPORTANT: keep it in sync with the FRONTEND's
# NEXT_PUBLIC_REQUEST_TIMEOUT_MS (= this x1000) - the frontend Next.js proxy and
# client abort first if they're shorter, so raising only the backend has no
# effect (this is why issue #776's backend-only edit didn't work).
REQUEST_TIMEOUT_SECONDS=240

# ===========================================
# Resource limits & abuse controls
# ===========================================
# Max simultaneous PDF renders (headless Chromium is heavy). Excess exports wait
# up to PDF_RENDER_QUEUE_TIMEOUT_SECONDS for a slot, then get 503 (backpressure).
PDF_MAX_CONCURRENCY=2
PDF_RENDER_QUEUE_TIMEOUT_SECONDS=30
# Rendered-PDF cache: repeat downloads of the same resume + appearance are served
# from memory instead of re-rendering via Chromium (near-instant). The cache key
# includes the resume content + resolved settings, so any edit/template change
# busts it - it never serves stale output. TTL in seconds; max entries bounds
# memory. Set PDF_CACHE_ENABLED=false to always render fresh.
PDF_CACHE_ENABLED=true
PDF_CACHE_TTL_SECONDS=900
PDF_CACHE_MAX_ENTRIES=64
# Warm headless Chromium in the background at startup so the FIRST export
# doesn't pay the browser cold-start. Non-blocking; safe to disable.
PDF_PREWARM_ENABLED=true
# Per-user rate limit (requests/minute) for expensive LLM generation endpoints
# (resume parse, tailor/improve, cover letter, outreach, interview prep,
# enrichment, resume wizard). Guards provider cost/abuse. 0 disables. Enforced
# via the shared KVStore, so it holds across workers when KVSTORE_URL is set.
LLM_RATE_PER_MIN_USER=20

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ===========================================
# Auth Foundation (P1 Multi-User) - see .kiro/specs/auth-foundation
# ===========================================
# Deployment mode. Local dev leaves this ON (single-user: auto-login owner, no
# email verification) so the app boots with ZERO auth config, identical to
# today. Any hosted/multi-user deployment MUST set this to false - which turns
# on the fail-fast requirements below (SESSION_SECRET, IP_HASH_SECRET, a
# Postgres DATABASE_URL, etc.).
SINGLE_USER_MODE=true

# Explicit deployment profile (declared intent - ARCHITECTURE §3/§4). Blank ->
# derived from SINGLE_USER_MODE (true->desktop, false->saas), so existing configs
# are unchanged. Valid values: desktop | saas | enterprise | self_hosted |
# development | test | ci. An invalid value fails fast at boot; a value that
# contradicts SINGLE_USER_MODE (e.g. saas + SINGLE_USER_MODE=true) is rejected.
DEPLOYMENT_PROFILE=

# --- Secrets (REQUIRED when SINGLE_USER_MODE=false) ---------------------------
# Session signing / CSRF derivation key. Min 16 chars. In local single-user mode
# a strong ephemeral value is generated per process if left blank (sessions
# reset on restart). Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Previous session secret - set ONLY during a rotation window so sessions signed
# with the old key still validate. Remove once rotation completes (see runbook).
SESSION_SECRET_PREV=
# Keyed HMAC secret used to hash client IPs (IPs are never stored in the clear).
# Min 16 chars. Ephemeral in local mode, REQUIRED in hosted mode.
IP_HASH_SECRET=

# Secret used to encrypt users' provider API keys at rest. Min 16 chars. MUST be
# stable across restarts/redeploys or stored keys become undecryptable (users'
# saved keys would appear wiped). REQUIRED in hosted mode; local mode falls back
# to a persistent on-disk secret. Accepts a Fernet key or any strong string.
# Generate one with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# --- Bootstrap owner (migration assigns all existing data to this user) -------
OWNER_EMAIL=owner@localhost
# Optional: set an initial owner password. Leave blank to create the owner
# without a password (they set one via password reset / OAuth link).
OWNER_PASSWORD=

# --- Email verification (R5) --------------------------------------------------
# Leave blank to use the mode default: ON for hosted, OFF for single-user/local.
# Set true/false to force it.
EMAIL_VERIFICATION=

# --- Google OAuth (optional; provider-abstracted, R4) -------------------------
# Set BOTH id and secret to enable "Sign in with Google". OAUTH_REDIRECT_URI is
# required when OAuth is configured on a hosted deployment (must be https and
# exact-match allow-listed at the provider).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_URI - the exact absolute URL Google redirects back to after
# sign-in. It is <your public origin> + the fixed callback path:
#     /api/v1/auth/oauth/google/callback
# Examples:
#   hosted:  https://your-domain.com/api/v1/auth/oauth/google/callback
#   local:   http://localhost:3000/api/v1/auth/oauth/google/callback
#   (backend-direct, NEXT_PUBLIC_API_URL=http://localhost:8000):
#            http://localhost:8000/api/v1/auth/oauth/google/callback
# Rules: full URL (scheme+host+path); must EXACTLY match an "Authorized redirect
# URI" in Google Cloud Console -> APIs & Services -> Credentials -> your OAuth 2.0
# Client ID; must be https:// in hosted mode (http allowed only for localhost).
# Required when GOOGLE_CLIENT_ID/SECRET are set in hosted mode; leave blank if
# Google sign-in is disabled.
OAUTH_REDIRECT_URI=

# --- Session lifetimes (seconds) ----------------------------------------------
# Absolute cap, the longer cap used for "remember me", and the idle timeout.
# Invariants: IDLE_TTL <= SESSION_ABSOLUTE_TTL <= REMEMBER_ME_TTL.
SESSION_ABSOLUTE_TTL=43200
REMEMBER_ME_TTL=2592000
IDLE_TTL=7200
# Step-up ("sudo") window for sensitive actions (password/email change, etc.).
STEP_UP_WINDOW=300

# --- Argon2id password hashing (R17.2; target ~50-100ms) ----------------------
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# --- Cookies (R12.1) ----------------------------------------------------------
# __Host- prefix requires Secure + Path=/ + no Domain. Keep COOKIE_SECURE=true;
# localhost is treated as a secure context by browsers.
SESSION_COOKIE_NAME=__Host-session
CSRF_COOKIE_NAME=csrf
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- KVStore (ADR-6) ----------------------------------------------------------
# Blank -> in-process local adapter (single-worker dev). Redis/Upstash ->
# redis:// or rediss:// URL. DB-backed fallback (no Redis at all) -> "db".
KVSTORE_URL=

# --- Database (ADR-13) --------------------------------------------------------
# Blank -> local SQLite file (unchanged local behavior). Hosted MUST set a pooled
# Postgres URL (Neon pooler / Supabase PgBouncer), e.g.
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx-pooler.neon.tech/db
DATABASE_URL=
DB_POOL_SIZE=5
DB_USE_POOLER=true
# Dedicated DIRECT (non-pooled, port 5432) connection string for DDL/migrations.
# On a transaction pooler (Supabase 6543 / PgBouncer), CREATE INDEX CONCURRENTLY
# and the migration advisory lock are unsafe, so migrations must use the direct
# endpoint. Blank -> fall back to DATABASE_URL (correct for local/direct hosts).
# MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:pass@db.<ref>.supabase.co:5432/postgres
MIGRATION_DATABASE_URL=
# Postgres TLS. Blank -> derive from DATABASE_URL's ?sslmode=..., else require in
# hosted mode / none locally. Explicit: disable|prefer|allow|require|verify-ca|
# verify-full. Normalized per-driver (asyncpg rejects a raw sslmode kwarg), so
# Supabase's TLS-only endpoints work. e.g. DB_SSL=require
DB_SSL=
# Run `alembic upgrade head` automatically at startup on hosted Postgres
# (SQLite is unaffected). Serialized across workers by a Postgres advisory lock
# and idempotent. Set false to migrate out-of-band in a release phase.
DB_AUTO_MIGRATE=true

# --- Free/premium infra toggles (ADR-14) --------------------------------------
# STORAGE_PROVIDER: local | cloudinary | s3  (free hosted default: cloudinary;
# s3 is reserved/not implemented)
STORAGE_PROVIDER=local
# Cloudinary credentials - all required when STORAGE_PROVIDER=cloudinary.
# Incomplete configuration fails startup rather than using ephemeral local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# SCHEDULER_MODE: external_cron | internal   (free hosted default: external_cron)
SCHEDULER_MODE=external_cron
# Shared secret guarding the internal machine endpoints (ADR-15):
#   POST /api/v1/internal/run-jobs  - the free-tier reaper hook a cron calls
#                                     (header: X-Internal-Job-Token: <token>)
#   GET  /api/v1/internal/metrics   - the auth metrics snapshot (JSON)
# Compared in constant time. Must be >= 16 chars when set. Blank = the endpoints
# reject every caller (never exposed unauthenticated); local dev never needs it.
INTERNAL_JOB_TOKEN=
# Interval (seconds) between reaper batches when SCHEDULER_MODE=internal. Hourly.
# The same interval drives the P2 admin jobs (rollup + purge) in `internal` mode.
REAPER_INTERVAL_SECONDS=3600

# --- P2 Admin subsystem (design admin/§Deployment) ----------------------------
# ADMIN_ENABLED: master flag for the /api/v1/admin/* surface. When off, every
# admin endpoint returns 404 admin_disabled (rollout: deploy flag-off, then on).
ADMIN_ENABLED=true
# ADMIN_DESTRUCTIVE_ACTIONS: kill-switch for irreversible erasure. When off,
# soft-delete/restore endpoints and the PurgeJob are refused/skipped - a value
# change disables destruction without a code deploy.
ADMIN_DESTRUCTIVE_ACTIONS=true
# ADMIN_DELETE_GRACE_DAYS: window between soft-delete and irreversible purge.
# A soft-deleted user is restorable until deleted_at + this. Bounded to [1, 365].
ADMIN_DELETE_GRACE_DAYS=7
# ADMIN_BULK_DISABLE_MAX: max targets in one POST /admin/users/bulk-disable.
ADMIN_BULK_DISABLE_MAX=100
# ADMIN_INVITE_TTL_HOURS: lifetime of a single-use admin-invite token (secure
# admin signup). Short by default so a leaked link expires fast; bounded [1,720].
# An existing admin issues invites at /admin/invites; redemption at
# /signup?invite=... creates an admin account bound to the invited email.
ADMIN_INVITE_TTL_HOURS=72

# --- Admin panel observability upgrade ----------------------------------------
# Tiered audit-log retention. A security-critical row is deleted once older than
# the hot window; a downsamplable row is aggregated-then-deleted past the
# downsample window. Blank -> the default below. Positive integers.
ADMIN_AUDIT_HOT_DAYS=365
ADMIN_AUDIT_DOWNSAMPLE_DAYS=90
# Max audit rows deleted per retention run. Bounded to [1, 100000].
ADMIN_AUDIT_RETENTION_BATCH=1000
# Age (days) beyond which metrics_daily rows are pruned (totals snapshot kept).
ADMIN_METRICS_RETENTION_DAYS=400
# Minimum minutes between DB-size samples taken by the rollup job.
ADMIN_DB_SIZE_SAMPLE_MINUTES=60
# Stuck-job detection: a running job is flagged when its duration exceeds
# multiplier × expected duration, or the ceiling (seconds) when no expected
# duration exists. Positive integers.
ADMIN_JOB_STUCK_MULTIPLIER=3
ADMIN_JOB_STUCK_CEILING_SECONDS=3600
# Minimal threshold alerting. Percentages bounded to [0, 100]; cooldown is the
# seconds an alert stays suppressed while its condition remains true.
ALERT_STORAGE_FULL_PCT=90
ALERT_ERROR_RATE_PCT=5
ALERT_COOLDOWN_SECONDS=3600

# --- Pluggable auth providers (ADR-14) ----------------------------------------
# Leave blank to use the shipped dev-safe defaults (email -> server log,
# CAPTCHA -> allow, breach check -> disabled). Real per-deploy adapters are
# selected by value; a missing-credential/unknown provider gracefully degrades
# to the dev-safe default with a logged warning (the app always boots).
#
# EMAIL_PROVIDER: blank|log (dev log) | smtp | resend
#   Live delivery needs EMAIL_FROM + creds below (SMTP host/creds, or Resend key).
EMAIL_PROVIDER=
EMAIL_FROM=
# Resend: HTTP API key (EMAIL_PROVIDER=resend)
EMAIL_API_KEY=
# SMTP transport (EMAIL_PROVIDER=smtp)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
# CONTACT_RECIPIENT_EMAIL: where public /contact form submissions are delivered.
#   Falls back to EMAIL_FROM when blank; if neither is set the message is still
#   persisted + logged (no delivery). Requires a working EMAIL_PROVIDER to send.
CONTACT_RECIPIENT_EMAIL=
# CAPTCHA_PROVIDER: blank|none (allow-all) | turnstile   (needs CAPTCHA_SECRET)
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
CAPTCHA_SITE_KEY=
# BREACH_PROVIDER: blank|none (disabled) | hibp   (HIBP k-anonymity, no creds)
BREACH_PROVIDER=

# ===========================================
# JD Extraction v2 (docs/architecture/JD_EXTRACT_ENHANCEMENTS_PLAN.md)
# ===========================================
# Master kill-switch for the "import job description from URL" feature. When
# off, POST /jobs/fetch-url returns 404.
JD_FROM_URL_ENABLED=true
# v2 cascade pipeline (Platform API -> JSON-LD -> Hydration -> DOM -> Playwright).
# Set false to fall back to the legacy v1 BeautifulSoup-only extractor.
JD_V2_ENABLED=true
# Per-user / global fetch rate limits (per minute) and concurrency cap.
JD_URL_RATE_PER_MIN_USER=10
JD_URL_RATE_PER_MIN_GLOBAL=120
JD_URL_MAX_CONCURRENCY=4
JD_URL_CACHE_TTL_SECONDS=3600
# Global wall-clock budget (seconds) for one v2 extraction.
JD_PIPELINE_TIMEOUT=20

# --- Phase 3 (Coverage & Polish) ----------------------------------------------
# PDF extraction pipeline (§20). Native text via pdfminer.six (always available).
JD_PDF_ENABLED=true
# Tesseract OCR fallback for scanned/image-only PDFs. OPT-IN: requires the `ocr`
# Python extra (pytesseract + pdf2image) AND the system `tesseract-ocr` +
# `poppler-utils` binaries. Off by default (scanned PDFs fail honestly instead).
JD_OCR_ENABLED=false
# Language detection + i18n section keywords / salary parsing (§21).
JD_I18N_ENABLED=true
# robots.txt policy check before fetching (§26). Fail-open when robots.txt is
# unreachable; honors a FitWrightBot-specific Disallow (ADR-13).
JD_ROBOTS_CHECK_ENABLED=true
# Cost monitoring + budget caps (§25). Playwright (the only paid step) is skipped
# when a cap is exhausted.
JD_COST_MONITORING_ENABLED=true
JD_COST_USER_DAILY_CAP_USD=0.5
JD_COST_GLOBAL_HOURLY_BREAK_USD=100.0

# --- Phase 4 (Advanced) -------------------------------------------------------
# Browser-extension fallback: accept a user's already-rendered DOM at
# POST /jobs/extract-rendered (for auth-walled / anti-bot / client-only pages).
JD_EXTENSION_FALLBACK_ENABLED=true
# ML content scorer - extra confidence signal for the ambiguous DOM/headless
# paths (downgrades likely-non-JD content). Off by default (opt-in).
JD_ML_SCORING_ENABLED=false
# Employer webhook ingestion (zero-scrape authoritative push) at POST /jobs/webhook.
# Requires a shared HMAC-SHA256 secret; endpoint 404s unless BOTH are set.
JD_WEBHOOK_ENABLED=false
JD_WEBHOOK_SECRET=
# Distributed browser pool: max concurrent Playwright renders across ALL workers
# (needs a shared Redis KVSTORE_URL to be global). 0 = per-process limiting only.
JD_DISTRIBUTED_RENDER_MAX=0
# Edge rendering: delegate Playwright to an external renderer (browserless.io or
# self-hosted). Blank = render locally. The endpoint receives {"url": ...} and
# returns HTML (text/html) or JSON {"html": "..."}.
JD_EDGE_RENDER_URL=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Job Discovery & Recommendations (optional feature)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
JOB_DISCOVERY=false
JOB_DISCOVERY_JOBSPY_SITES=indeed
JOB_DISCOVERY_CACHE_TTL_SECONDS=3600
JOB_DISCOVERY_MAX_RESULTS=50
JOB_DISCOVERY_MAX_RECIPES=20
JOB_DISCOVERY_STEALTH_MAX_CONCURRENCY=1

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Browser Extension (apps/extension)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Comma-separated chrome-extension:// origins allowed to call the API with
# credentials. Blank by default: the extension surface is opt-in.
#
# This is not hardcoded because the origin is not stable until you have the
# build. A packed extension from the Web Store keeps one id forever, but an
# unpacked dev build gets a fresh id per machine - so load the extension first,
# copy the id Chrome shows on chrome://extensions, then set this and restart.
#
# The /extension/* routes also require JOB_DISCOVERY=true; with it false the
# whole surface 404s and the extension reports "feature disabled".
EXTENSION_ORIGINS=
# Example:
# EXTENSION_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop

# ---------------------------------------------------------------------------
# Credit purchases (optional). Prices are NOT set here - they live in the
# credit_packs table and are edited in Admin > Credit packs, so changing a price
# or running an offer needs no redeploy.
# ---------------------------------------------------------------------------
# Leave false and nothing is for sale. Requires AI_CREDITS_ENABLED=true as well:
# selling credits that nothing will spend or meter makes no sense.
AI_PURCHASES_ENABLED=false
# "razorpay" or "fake". "fake" is for tests only - it takes no money.
AI_PAYMENT_PROVIDER=fake

# Publishable key. Served to the browser at runtime by the API rather than baked into
# the frontend build, so rotating it does not need an image rebuild.
RAZORPAY_KEY_ID=
# Server only - NEVER expose this to the frontend. Signs the checkout callback.
RAZORPAY_KEY_SECRET=
# A SEPARATE secret shown once when you create the webhook in the Razorpay dashboard.
# Webhooks are signed with this over the RAW request body; the key secret above will
# not verify them. Webhook endpoint: POST /api/v1/credits/purchase/webhook
# Subscribe to: order.paid, payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=
