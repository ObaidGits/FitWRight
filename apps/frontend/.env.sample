# Resume Matcher Frontend Configuration
# Copy this file to .env.local and update values as needed

# ===========================================
# API Configuration
# ===========================================
# Backend API URL - defaults to "/" (same-origin, proxied by Next.js rewrites).
# Only change this if running the backend on a separate host/port during development.
# NEXT_PUBLIC_API_URL=/

# ===========================================
# SEO / Canonical origin
# ===========================================
# Absolute public origin of the site (no trailing slash). Drives canonical URLs,
# sitemap.xml, robots.txt, Open Graph/Twitter URLs, and JSON-LD entity IDs.
# Set this per environment (production, staging, preview). Defaults to the
# production domain when unset.
# NEXT_PUBLIC_SITE_URL=https://fitwright.app

# Search-engine site verification tokens. Optional - a verification <meta> tag
# is emitted only for the tokens you set. Obtain these from each webmaster tool.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=   # Google Search Console
# NEXT_PUBLIC_BING_SITE_VERIFICATION=     # Bing Webmaster Tools (msvalidate.01)
# NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=   # Yandex Webmaster

# Origin used for server-side (SSR) API calls when NEXT_PUBLIC_API_URL is a
# relative path. Defaults to the co-located backend in the bundled image.
# Override for split deployments where the backend runs on a different host.
# INTERNAL_API_ORIGIN=http://127.0.0.1:8000

# Request timeout in milliseconds for long-running calls (resume tailoring),
# applied to both the Next.js API proxy and the client fetch. Default 240000
# (240s). Raise it for slow local LLMs; bounded to [30000, 1800000].
# IMPORTANT: keep it in sync with the BACKEND's REQUEST_TIMEOUT_SECONDS
# (= this / 1000) - the shortest of the two aborts first.
# NEXT_PUBLIC_REQUEST_TIMEOUT_MS=240000

# ===========================================
# Development Server (optional)
# ===========================================
# To change the frontend port, use: npm run dev -- -p 3001
# Or add to package.json scripts: "dev": "next dev --turbopack -p 3001"
#
# If you change the frontend port, make sure to update:
# 1. Backend CORS_ORIGINS to include your new frontend URL
# 2. Backend FRONTEND_BASE_URL to point to your new frontend URL