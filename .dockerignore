# Git
.git
.gitignore

# Node
**/node_modules
**/.next
**/out

# Python
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.mypy_cache
**/*.egg-info
**/.venv
**/venv

# Environment files never belong in the build context. Runtime configuration
# must be injected by the deployment platform or mounted as *_FILE secrets.
**/.env*

# VCS and IDE metadata
.git
.github
.vscode
.idea
*.swp
*.swo

# Documentation (not needed in image)
*.md
!README.md
docs/
assets/

# Build and test artifacts
**/coverage
**/htmlcov
**/test-results
**/*.tsbuildinfo
dist/

# Local runtime data and credentials are mounted/injected at runtime
**/data/.secret_key
**/data/config.json
**/config.json
**/*.db
**/*.db-wal
**/*.db-shm
build/

# Test files
**/tests/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Data directory (mounted as volume)
apps/backend/data/

# OS files
.DS_Store
Thumbs.db

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore

# Config file with API keys - NEVER COMMIT
config.json
**/config.json
