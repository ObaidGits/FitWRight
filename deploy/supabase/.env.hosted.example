# =============================================================================
# Hosted deployment env template - Supabase (or any) Postgres (Goal A)
# =============================================================================
# This is the delta from apps/backend/.env.example needed to run the app with
# Supabase as the Postgres HOST. The app stays provider-neutral: nothing here is
# a Supabase SDK/API key - DATABASE_URL is the only Supabase-specific value, and
# it is a standard Postgres connection string. Swapping providers = swapping
# this one line (see deploy/supabase/RUNBOOK.md).

# --- Deployment mode ---------------------------------------------------------
# Hosted/multi-user MUST turn single-user off. This flips on the fail-fast
# requirements below (SESSION_SECRET, IP_HASH_SECRET, a Postgres DATABASE_URL).
SINGLE_USER_MODE=false

# --- Database (the only Supabase-specific setting) ---------------------------
# Use Supabase's **pooled** connection string for the app runtime - the
# Connection Pooling (Transaction) endpoint, port 6543. asyncpg + the app's
# pooler-safe engine options (statement_cache_size=0) require the transaction
# pooler; keep DB_USE_POOLER=true to match.
#
# Supabase -> Project Settings -> Database -> Connection string -> "Connection
# pooling" (Transaction). It looks like:
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# The app normalizes the driver, so postgresql:// / postgres:// are both fine.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_USE_POOLER=true
DB_POOL_SIZE=5
# Supabase endpoints are TLS-only. This is applied automatically in hosted mode
# (SINGLE_USER_MODE=false defaults to require) even if the URL omits sslmode;
# set explicitly to be safe. verify-full additionally validates the CA chain.
DB_SSL=require
# Schema is brought to head automatically at startup, under an advisory lock
# (safe across multiple instances). Set false only if you run migrations in a
# dedicated release step against the DIRECT (5432) endpoint.
DB_AUTO_MIGRATE=true

# IMPORTANT: run schema migrations against the **DIRECT** endpoint (port 5432),
# NOT the pooler - DDL / CREATE INDEX CONCURRENTLY misbehave under transaction
# pooling. Set this only for the `alembic upgrade head` step (see RUNBOOK):
#   ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# --- Required secrets in hosted mode (generic, NOT Supabase-specific) --------
# Generate SESSION_SECRET / IP_HASH_SECRET with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=
IP_HASH_SECRET=
# Encrypts users' provider API keys at rest. MUST stay constant across redeploys
# (an ephemeral filesystem regenerates the on-disk fallback every release, which
# silently wipes stored keys). Generate with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# --- Bootstrap owner (migration assigns pre-existing data to this user) ------
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=

# --- CORS / frontend ---------------------------------------------------------
FRONTEND_BASE_URL=https://your-app-domain
CORS_ORIGINS=["https://your-app-domain"]

# --- Storage: keep files OUT of Postgres to slow DB growth (Phase 2) ---------
# Supabase Postgres free tier is size-limited; store avatars/files in object
# storage so uploads don't inflate the DB or your pg_dump backups. This uses the
# app's existing provider abstraction (no Supabase Storage dependency).
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- LLM provider (unchanged from base .env.example) -------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-nano-2025-08-07
LLM_API_KEY=sk-your-api-key-here

# --- Optional: Google OAuth (unchanged; provider-abstracted) -----------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=https://your-app-domain/api/v1/auth/oauth/google/callback
